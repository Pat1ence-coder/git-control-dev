{
  "name": "generative-git",
  "displayName": "Generative Git",
  "description": "查看 Git 提交历史、管理未暂存更改、解决合并冲突并审查提交",
  "version": "0.7.3",
  "publisher": "generative-git-local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:generativeGit.main",
    "onCommand:generativeGit.open",
    "onCommand:generativeGit.refresh",
    "onCommand:generativeGit.setDeepSeekKey",
    "onCommand:generativeGit.clearDeepSeekKey"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "generativeGit.clearBackups",
        "title": "Generative Git: 清理冲突修改备份"
      },
      {
        "command": "generativeGit.openBackup",
        "title": "Generative Git: 打开冲突修改备份"
      },
      {
        "command": "generativeGit.open",
        "title": "Generative Git: 打开工作台"
      },
      {
        "command": "generativeGit.refresh",
        "title": "Generative Git: 刷新仓库"
      },
      {
        "command": "generativeGit.setDeepSeekKey",
        "title": "Generative Git: 设置 DeepSeek API Key"
      },
      {
        "command": "generativeGit.clearDeepSeekKey",
        "title": "Generative Git: 清除 DeepSeek API Key"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "generative-git",
          "title": "Generative Git",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "generative-git": [
        {
          "id": "generativeGit.main",
          "name": "Generative Git",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Generative Git AI",
      "properties": {
        "generativeGit.ai.model": {
          "type": "string",
          "enum": [
            "deepseek-v4-pro",
            "deepseek-flash"
          ],
          "default": "deepseek-v4-pro",
          "description": "DeepSeek 模型。v4-pro 适合复杂 Git 决策，flash 更快。"
        },
        "generativeGit.ai.reasoningEffort": {
          "type": "string",
          "enum": [
            "auto",
            "low",
            "high",
            "max"
          ],
          "default": "high",
          "description": "DeepSeek thinking 强度。auto 目前映射到 high；官方没有真正的 medium。"
        },
        "generativeGit.ai.thinking": {
          "type": "boolean",
          "default": true,
          "description": "启用 DeepSeek thinking。关闭后不请求 reasoning_content。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p . --noEmit && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "npm run compile && node --test dist/test.js",
    "test:host": "npm run compile && node scripts/test-host.mjs",
    "vscode:prepublish": "npm run compile",
    "test:ui": "npm run compile && node scripts/test-thread-ui.mjs && node scripts/test-motion-ui.mjs"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  },
  "license": "SEE LICENSE IN LICENSE-MIT"
}
